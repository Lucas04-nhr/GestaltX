            "value": "可能需要重新啟動裝置才能生效。"
          }
        }
      }
    },
    "Restart the device after changing the region.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart the device after changing the region."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改地区后需要重新启动设备。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicia el dispositivo después de cambiar la región."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پس از تغییر منطقه، دستگاه را دوباره راه‌اندازی کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地域を変更した後、デバイスを再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지역을 변경한 후 기기를 재시동하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После смены региона перезагрузите устройство."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bölgeyi değiştirdikten sonra cihazı yeniden başlatın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khởi động lại thiết bị sau khi đổi vùng."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "更改地區後需要重新啓動設備。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "更改地區後需要重新啟動裝置。"
          }
        }
      }
    },
    "Some changes require a device restart.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some changes require a device restart."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分更改需要重新启动设备。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos cambios requieren reiniciar el dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برخی تغییرات به راه‌اندازی مجدد دستگاه نیاز دارند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更によってはデバイスの再起動が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 변경 사항은 기기 재시동이 필요합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые изменения требуют перезагрузки устройства."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı değişiklikler cihazın yeniden başlatılmasını gerektirir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số thay đổi cần khởi động lại thiết bị."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "部分更改需要重新啓動設備。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "部分更改需要重新啟動裝置。"
          }
        }
      }
    },
    "Restart required. Apple Intelligence also depends on device and region.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart required. Apple Intelligence also depends on device and region."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要重新启动设备。Apple 智能还取决于机型与地区。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicio requerido. Apple Intelligence también depende del dispositivo y de la región."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "راه‌اندازی مجدد لازم است. Apple Intelligence به دستگاه و منطقه نیز بستگی دارد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再起動が必要です。Apple Intelligenceはデバイスと地域にも依存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재시동이 필요합니다. Apple Intelligence는 기기 모델 및 지역 제한의 영향을 받습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется перезагрузка. Доступность Apple Intelligence также зависит от устройства и региона."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden başlatma gerekli. Apple Intelligence ayrıca cihaza ve bölgeye bağlıdır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần khởi động lại. Apple Intelligence còn tùy thuộc vào thiết bị và vùng."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "需要重新啓動設備。Apple 智能還取決於機型與地區。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "需要重新啟動裝置。Apple 智慧還取決於機型與地區。"
          }
        }
      }
    },
    "Restart the device, then reopen Settings. Pencil hardware support is still required.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart the device, then reopen Settings. Pencil hardware support is still required."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新启动设备后再打开“设置”，仍需要 Apple Pencil 硬件支持。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicia el dispositivo y luego vuelve a abrir Configuración. Aún se requiere compatibilidad de hardware con Apple Pencil."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دستگاه را دوباره راه‌اندازی کنید و تنظیمات را باز کنید. پشتیبانی سخت‌افزاری Apple Pencil همچنان لازم است."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスを再起動してから設定を開き直してください。Apple Pencil対応ハードウェアも必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기를 재시동한 후 설정을 다시 여십시오. 하드웨어 차원의 Apple Pencil 지원은 여전히 필요합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезагрузите устройство и снова откройте «Настройки». Требуется аппаратная поддержка Apple Pencil."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazı yeniden başlatın, sonra Ayarlar'ı yeniden açın. Yine de Pencil donanım desteği gerekir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khởi động lại thiết bị rồi mở lại Cài đặt. Thiết bị vẫn cần phần cứng hỗ trợ Apple Pencil."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "重新啓動設備後再打開“設定”，仍需要 Apple Pencil 硬件支持。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "重新啟動裝置後再開啟“設定”，仍需要 Apple Pencil 硬體支援。"
          }
        }
      }
    },
    "Respring first. Restart the device if the change does not appear.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Respring first. Restart the device if the change does not appear."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先执行注销，若未生效则重新启动设备。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz un respring primero. Reinicia el dispositivo si el cambio no aparece."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ابتدا ری‌اسپرینگ کنید. اگر تغییر دیده نشد، دستگاه را دوباره راه‌اندازی کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずRespringしてください。変更が表示されない場合はデバイスを再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 리스프링을 실행하십시오. 변경 사항이 나타나지 않으면 기기를 재시동하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала выполните респринг. Если изменения не появились, перезагрузите устройство."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce respring yapın. Değişiklik görünmezse cihazı yeniden başlatın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy respring trước. Nếu thay đổi chưa xuất hiện, hãy khởi động lại thiết bị."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "先執行註銷，若未生效則重新啓動設備。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "先執行登出，若未生效則重新啟動裝置。"
          }
        }
      }
    },
    "Write verified. Some features require a device restart.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write verified. Some features require a device restart."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写入已验证。部分功能需要重新启动设备才能生效。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escritura verificada. Algunas funciones requieren reiniciar el dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نوشتن تأیید شد. برخی قابلیت‌ها به راه‌اندازی مجدد دستگاه نیاز دارند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
