        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập mã 6 chữ số hiển thị bên dưới, trong Dynamic Island hoặc trong thông báo"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入下方、動態島或通知中顯示的 6 位數配對碼"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入下方、動態島或通知中顯示的 6 位數配對碼"
          }
        }
      }
    },
    "The pairing code appears here, in the Dynamic Island, and as a notification.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pairing code appears here, in the Dynamic Island, and as a notification."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对码会显示在这里，也会出现在灵动岛和通知里。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código de emparejamiento aparece aquí, en la Dynamic Island y en una notificación."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کد جفت‌سازی اینجا، در Dynamic Island و در اعلان نمایش داده می‌شود."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングコードはここ、Dynamic Island、通知に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링 코드는 여기, Dynamic Island 및 알림에 표시됩니다."
          }
        },
        "ru": {
          "stringUnit": {
