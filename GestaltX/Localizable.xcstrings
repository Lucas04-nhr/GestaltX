    "Device file access was denied. Check the OS version and App Group signing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device file access was denied. Check the OS version and App Group signing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备文件访问被拒绝，请检查系统版本和 App Group 签名。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se denegó el acceso a los archivos del dispositivo. Comprueba la versión del sistema y la firma del App Group."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به فایل دستگاه رد شد. نسخهٔ سیستم‌عامل و امضای App Group را بررسی کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスのファイルへのアクセスが拒否されました。OSのバージョンとApp Groupの署名を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
