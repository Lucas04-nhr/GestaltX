    "Enter this code on the device to confirm pairing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter this code on the device to confirm pairing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设备上输入这串配对码即可完成配对。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce este código en el dispositivo para confirmar el emparejamiento."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کد را روی دستگاه وارد کنید تا جفت‌سازی تأیید شود."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスにこのコードを入力してペアリングを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에 이 코드를 입력해 페어링을 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите этот код на устройстве, чтобы подтвердить сопряжение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleştirmeyi onaylamak için bu kodu cihazda girin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập mã này trên thiết bị để xác nhận ghép nối."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在裝置上輸入此碼以確認配對。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在裝置上輸入此碼以確認配對。"
          }
        }
      }
    },
