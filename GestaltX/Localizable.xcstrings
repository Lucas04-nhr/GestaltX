          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu tệp đã xóa: %@. Lỗi: %lld. Liên kết hoặc tệp đặc biệt đã bỏ qua: %lld."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "已刪除檔案資料：%@。錯誤：%lld 項。略過連結或特殊檔案：%lld 項。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "已刪除檔案資料：%@。錯誤：%lld 項。略過連結或特殊檔案：%lld 項。"
          }
        }
      }
    },
    "Container scanning requires a supported physical device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Container scanning requires a supported physical device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "容器扫描需要受支持的真实设备。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El escaneo de contenedores requiere un dispositivo físico compatible."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اسکن محفظه‌ها به دستگاه واقعی پشتیبانی‌شده نیاز دارد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテナのスキャンには対応する実機が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컨테이너 검색에는 지원되는 실제 기기가 필요합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для сканирования контейнеров требуется поддерживаемое физическое устройство."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapsayıcı taraması desteklenen fiziksel bir cihaz gerektirir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét vùng chứa yêu cầu thiết bị thực được hỗ trợ."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "容器掃描需要受支援的實體裝置。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "容器掃描需要受支援的實體裝置。"
          }
        }
      }
    },
    "Container discovery failed. Check device access and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Container discovery failed. Check device access and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "容器发现失败，请检查设备访问权限后重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron detectar los contenedores. Comprueba el acceso al dispositivo e inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یافتن محفظه‌ها ناموفق بود. دسترسی دستگاه را بررسی و دوباره تلاش کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテナを検出できませんでした。デバイスへのアクセスを確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컨테이너 검색에 실패했습니다. 기기 접근 권한을 확인하고 다시 시도하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось найти контейнеры. Проверьте доступ к устройству и повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
