        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰기 검증을 완료했습니다. 일부 기능은 기기를 재시동해야 적용됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
