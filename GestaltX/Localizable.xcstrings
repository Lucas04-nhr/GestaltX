    "Local file backups can be opened or exported, but not restored to this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local file backups can be opened or exported, but not restored to this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地文件备份只能打开或导出，不能恢复到本机。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los respaldos de archivos locales se pueden abrir o exportar, pero no restaurar en este dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پشتیبان‌های فایل محلی را می‌توان باز یا صادر کرد، اما نمی‌توان روی این دستگاه بازیابی کرد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルファイルのバックアップは開いたり書き出したりできますが、このデバイスには復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 파일 백업은 열거나 내보낼 수 있지만 이 기기에 복원할 수는 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервные копии локальных файлов можно открыть или экспортировать, но нельзя восстановить на это устройство."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel dosya yedekleri açılabilir veya dışa aktarılabilir, ancak bu cihaza geri yüklenemez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao lưu tệp cục bộ chỉ có thể mở hoặc xuất, không thể khôi phục về thiết bị này."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "本地文件備份只能打開或導出，不能恢復到本機。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "本地檔案備份只能開啟或匯出，不能恢復到本機。"
          }
        }
      }
    },
    "Read MobileGestalt in Tools, or open a backup as a local document.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read MobileGestalt in Tools, or open a backup as a local document."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“工具”中读取 MobileGestalt，或将备份作为本地文稿打开。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee MobileGestalt en Herramientas o abre un respaldo como documento local."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "MobileGestalt را در ابزارها بخوانید یا یک نسخهٔ پشتیبان را به‌عنوان سند محلی باز کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ツール」でMobileGestaltを読み込むか、バックアップをローカル書類として開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구에서 MobileGestalt를 읽거나 백업을 로컬 문서로 여세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитайте MobileGestalt во вкладке «Инструменты» или откройте резервную копию как локальный документ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araçlar'da MobileGestalt'ı okuyun veya bir yedeği yerel belge olarak açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc MobileGestalt trong Công cụ, hoặc mở một bản sao lưu dưới dạng tài liệu cục bộ."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「工具」中讀取 MobileGestalt，或將備份作為本地文稿打開。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「工具」中讀取 MobileGestalt，或將備份作為本地文稿開啟。"
          }
        }
      }
    },
    "Read MobileGestalt on this device before restoring a backup.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read MobileGestalt on this device before restoring a backup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在本机读取 MobileGestalt，再恢复备份。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee MobileGestalt en este dispositivo antes de restaurar un respaldo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از بازیابی نسخهٔ پشتیبان، MobileGestalt را روی این دستگاه بخوانید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップを復元する前に、このデバイスでMobileGestaltを読み込んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업을 복원하기 전에 이 기기에서 MobileGestalt를 읽으세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитайте MobileGestalt на этом устройстве перед восстановлением резервной копии."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir yedeği geri yüklemeden önce bu cihazda MobileGestalt'ı okuyun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy đọc MobileGestalt trên thiết bị này trước khi khôi phục bản sao lưu."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在本機讀取 MobileGestalt，再恢復備份。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在本機讀取 MobileGestalt，再恢復備份。"
          }
        }
      }
    },
    "Restore this backup to this device?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore this backup to this device?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将这个备份恢复到本机？"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Restaurar este respaldo en este dispositivo?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این نسخهٔ پشتیبان روی این دستگاه بازیابی شود؟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックアップをこのデバイスに復元しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 백업을 이 기기에 복원할까요?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановить эту резервную копию на это устройство?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yedek bu cihaza geri yüklensin mi?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục bản sao lưu này về thiết bị này?"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "將這個備份恢復到本機？"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "將這個備份恢復到本機？"
          }
        }
      }
    },
    "Restore writes a backup to this device. Open loads it as a local document for viewing and editing, and never changes the device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore writes a backup to this device. Open loads it as a local document for viewing and editing, and never changes the device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“恢复”会将备份写入本机。“打开”会将备份作为本地文稿载入，供查看和编辑，不会更改本机文件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar escribe un respaldo en este dispositivo. Abrir lo carga como documento local para verlo y editarlo, y nunca cambia el dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "«بازیابی» نسخهٔ پشتیبان را روی این دستگاه می‌نویسد. «باز کردن» آن را به‌عنوان سند محلی برای مشاهده و ویرایش بارگذاری می‌کند و هرگز دستگاه را تغییر نمی‌دهد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「復元」はバックアップをこのデバイスに書き込みます。「開く」はローカル書類として読み込んで表示・編集するもので、デバイスは変更しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'복원'은 백업을 이 기기에 기록합니다. '열기'는 백업을 로컬 문서로 불러와 보고 편집할 수 있게 하며, 기기는 절대 변경하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Восстановить» записывает резервную копию на это устройство. «Открыть» загружает её как локальный документ для просмотра и редактирования и никогда не изменяет устройство."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri Yükle, bir yedeği bu cihaza yazar. Aç ise onu görüntüleme ve düzenleme için yerel belge olarak yükler ve cihazı asla değiştirmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục sẽ ghi bản sao lưu vào thiết bị này. Mở sẽ tải nó dưới dạng tài liệu cục bộ để xem và chỉnh sửa, và không bao giờ thay đổi thiết bị."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "「恢復」會將備份寫入本機。「打開」會將備份作為本地文稿載入，供查看和編輯，不會更改本機文件。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "「恢復」會將備份寫入本機。「開啟」會將備份作為本地文稿載入，供查看和編輯，不會更改本機檔案。"
          }
        }
      }
    },
    "Saved to Backups. Restore it from the Backups tab.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved to Backups. Restore it from the Backups tab."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存到备份列表，可在“备份”页恢复到本机。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado en Respaldos. Restáuralo desde la pestaña Respaldos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در پشتیبان‌ها ذخیره شد. آن را از زبانهٔ پشتیبان‌ها بازیابی کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップに保存しました。「バックアップ」タブから復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업에 저장되었습니다. 백업 탭에서 복원하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранено в резервные копии. Восстановите файл на вкладке «Резервные копии»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedekler'e kaydedildi. Yedekler sekmesinden geri yükleyebilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu vào Bản sao lưu. Hãy khôi phục nó từ tab Bản sao lưu."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存到備份列表，可在「備份」頁恢復到本機。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存到備份列表，可在「備份」頁恢復到本機。"
          }
        }
      }
    },
    "The current device file is backed up first. The restored file is read back and verified. Restart the device afterward.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current device file is backed up first. The restored file is read back and verified. Restart the device afterward."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会先备份本机当前文件，恢复后会读回并验证。完成后请重新启动设备。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero se respalda el archivo actual del dispositivo. El archivo restaurado se vuelve a leer y se verifica. Reinicia el dispositivo después."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ابتدا از فایل فعلی دستگاه پشتیبان گرفته می‌شود. فایل بازیابی‌شده دوباره خوانده و تأیید می‌شود. سپس دستگاه را دوباره راه‌اندازی کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず現在のデバイスのファイルをバックアップします。復元したファイルは読み戻して検証されます。完了後、デバイスを再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 기기 파일을 먼저 백업합니다. 복원된 파일은 다시 읽어 검증합니다. 완료 후 기기를 재시동하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала создаётся резервная копия текущего файла устройства. Восстановленный файл считывается и проверяется. После этого перезагрузите устройство."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce geçerli cihaz dosyası yedeklenir. Geri yüklenen dosya yeniden okunup doğrulanır. Ardından cihazı yeniden başlatın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp hiện tại của thiết bị sẽ được sao lưu trước. Tệp đã khôi phục sẽ được đọc lại và xác minh. Sau đó hãy khởi động lại thiết bị."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "會先備份本機目前的文件，恢復後會讀回並驗證。完成後請重新啟動裝置。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "會先備份本機目前的檔案，恢復後會讀回並驗證。完成後請重新啟動裝置。"
          }
        }
      }
    },
    "Save this plist to Backups?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save this plist to Backups?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要将此 plist 保存到备份列表吗？"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Guardar este plist en Respaldos?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این plist در پشتیبان‌ها ذخیره شود؟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このplistをバックアップに保存しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 plist를 백업에 저장할까요?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранить этот plist в резервные копии?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu plist Yedekler'e kaydedilsin mi?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu plist này vào Bản sao lưu?"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "要將此 plist 保存到備份列表嗎？"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "要將此 plist 儲存到備份列表嗎？"
          }
        }
      }
    },
    "Make sure you know where this file came from. Do not restore files from unknown sources.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure you know where this file came from. Do not restore files from unknown sources."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请务必确认此文件的来源，不要恢复来源不明的文件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de saber de dónde procede este archivo. No restaures archivos de origen desconocido."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مطمئن شوید که می‌دانید این فایل از کجا آمده است. فایل‌هایی با منبع نامشخص را بازیابی نکنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルの入手元を必ず確認してください。入手元の分からないファイルは復元しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일의 출처를 반드시 확인하세요. 출처를 알 수 없는 파일은 복원하지 마세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убедитесь, что знаете, откуда этот файл. Не восстанавливайте файлы из неизвестных источников."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosyanın nereden geldiğini bildiğinizden emin olun. Kaynağı bilinmeyen dosyaları geri yüklemeyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy chắc chắn bạn biết tệp này đến từ đâu. Không khôi phục các tệp không rõ nguồn gốc."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請務必確認此文件的來源，不要恢復來源不明的文件。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請務必確認此檔案的來源，不要恢復來源不明的檔案。"
          }
        }
      }
    },
    "%@ does not officially support this feature.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ does not officially support this feature."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 官方不支持此功能。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no admite oficialmente esta función."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ به‌طور رسمی از این ویژگی پشتیبانی نمی‌کند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はこの機能に公式には対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 기기는 이 기능을 공식적으로 지원하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ официально не поддерживает эту функцию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bu özelliği resmi olarak desteklemiyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ không hỗ trợ chính thức tính năng này."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 官方不支援此功能。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 官方不支援此功能。"
          }
        }
      }
    },
    "Apple Intelligence is not officially available on mainland China models.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence is not officially available on mainland China models."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中国大陆机型官方不提供 Apple 智能。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence no está disponible oficialmente en los modelos de China continental."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence به‌طور رسمی روی مدل‌های سرزمین اصلی چین در دسترس نیست."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中国本土モデルでは、Apple Intelligenceは公式には利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중국 본토 모델에서는 Apple Intelligence를 공식적으로 사용할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence официально недоступна на моделях для материкового Китая."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence, Çin anakarası modellerinde resmi olarak kullanılamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence không được cung cấp chính thức trên các mẫu dành cho Trung Quốc đại lục."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
