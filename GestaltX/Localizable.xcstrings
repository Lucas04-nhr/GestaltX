    "Read-only. The open document is compared with this device's actual model, which comes from the system rather than the MobileGestalt cache.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only. The open document is compared with this device's actual model, which comes from the system rather than the MobileGestalt cache."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只读检查。会将当前文稿与本机的真实机型比对，机型由系统直接提供，而非来自 MobileGestalt 缓存。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lectura. El documento abierto se compara con el modelo real de este dispositivo, que proviene del sistema y no de la caché de MobileGestalt."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط خواندنی. سند باز با مدل واقعی این دستگاه مقایسه می‌شود که از سیستم گرفته می‌شود، نه از حافظهٔ پنهان MobileGestalt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り専用です。開いている書類を、このデバイスの実際のモデルと比較します。モデルはMobileGestaltキャッシュではなくシステムから取得します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기 전용입니다. 열린 문서를 이 기기의 실제 모델과 비교하며, 실제 모델은 MobileGestalt 캐시가 아닌 시스템에서 가져옵니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только чтение. Открытый документ сравнивается с фактической моделью устройства, которую сообщает система, а не кэш MobileGestalt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Salt okunur. Açık belge, bu cihazın gerçek modeliyle karşılaştırılır; model bilgisi MobileGestalt önbelleğinden değil, sistemden alınır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ đọc. Tài liệu đang mở được so sánh với kiểu máy thực tế của thiết bị, do hệ thống cung cấp chứ không lấy từ bộ nhớ đệm MobileGestalt."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "唯讀檢查。會將目前文稿與本機的真實機型比對，機型由系統直接提供，而非來自 MobileGestalt 緩存。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "唯讀檢查。會將目前文稿與本機的真實機型比對，機型由系統直接提供，而非來自 MobileGestalt 快取。"
          }
        }
      }
    },
    "The cached product type is %@, but this device reports %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cached product type is %@, but this device reports %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缓存中的产品类型为 %1$@，但本机实际为 %2$@。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tipo de producto en caché es %1$@, pero este dispositivo indica %2$@."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نوع محصول در حافظهٔ پنهان %1$@ است، اما این دستگاه %2$@ را گزارش می‌کند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュの製品タイプは%1$@ですが、このデバイスは%2$@と報告しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐시된 제품 유형은 %1$@이지만 이 기기는 %2$@(으)로 보고합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В кэше указан тип продукта %1$@, но устройство сообщает %2$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önbellekteki ürün türü %1$@, ancak bu cihaz %2$@ bildiriyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Loại sản phẩm trong bộ nhớ đệm là %1$@, nhưng thiết bị này báo là %2$@."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "緩存中的產品類型為 %1$@，但本機實際為 %2$@。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "快取中的產品類型為 %1$@，但本機實際為 %2$@。"
          }
        }
      }
    },
    "The model name is %@, but this device is %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model name is %@, but this device is %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机型名称为 %1$@，但本机实际为 %2$@。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre de modelo es %1$@, pero este dispositivo es %2$@."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نام مدل %1$@ است، اما این دستگاه %2$@ است."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデル名は%1$@ですが、このデバイスは%2$@です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 이름은 %1$@이지만 이 기기는 %2$@입니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Название модели — %1$@, но это устройство — %2$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model adı %1$@, ancak bu cihaz %2$@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên kiểu máy là %1$@, nhưng thiết bị này là %2$@."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "機型名稱為 %1$@，但本機實際為 %2$@。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "機型名稱為 %1$@，但本機實際為 %2$@。"
          }
        }
      }
    },
    "The region code %@ does not match the sales-region suffix %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The region code %@ does not match the sales-region suffix %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地区代码 %1$@ 与销售地区后缀 %2$@ 不一致。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código de región %1$@ no coincide con el sufijo de región de venta %2$@."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کد منطقهٔ %1$@ با پسوند منطقهٔ فروش %2$@ مطابقت ندارد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地域コード%1$@は販売地域のサフィックス%2$@と一致しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지역 코드 %1$@이(가) 판매 지역 접미사 %2$@와(과) 일치하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код региона %1$@ не совпадает с суффиксом региона продажи %2$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bölge kodu, %2$@ satış bölgesi sonekiyle eşleşmiyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã vùng %1$@ không khớp với hậu tố vùng bán hàng %2$@."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "地區代碼 %1$@ 與銷售地區後綴 %2$@ 不一致。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "地區代碼 %1$@ 與銷售地區後綴 %2$@ 不一致。"
          }
        }
      }
    },
    "These items have no reliable reference for this device, so they are never reported.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These items have no reliable reference for this device, so they are never reported."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些项目在本机上没有可靠的参考依据，因此不会被报告。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos elementos no tienen una referencia fiable para este dispositivo, por lo que nunca se informan."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این موارد برای این دستگاه مرجع قابل‌اعتمادی ندارند، بنابراین هرگز گزارش نمی‌شوند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの項目にはこのデバイスでの信頼できる基準がないため、報告されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목들은 이 기기에 대한 신뢰할 수 있는 기준이 없어 보고되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этих элементов нет надёжного эталона для этого устройства, поэтому о них не сообщается."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu öğelerin bu cihaz için güvenilir bir referansı olmadığından hiçbir zaman bildirilmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mục này không có tham chiếu đáng tin cậy cho thiết bị này nên sẽ không được báo cáo."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "這些項目在本機上沒有可靠的參考依據，因此不會被報告。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "這些項目在本機上沒有可靠的參考依據，因此不會被報告。"
          }
        }
      }
    },
    "This feature is only official on iPad.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This feature is only official on iPad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此功能仅在 iPad 上为官方设定。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta función solo es oficial en iPad."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این ویژگی فقط روی iPad رسمی است."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この機能はiPadでのみ公式です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기능은 iPad에서만 공식 지원됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта функция официальна только на iPad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu özellik yalnızca iPad'de resmidir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tính năng này chỉ chính thức trên iPad."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此功能僅在 iPad 上為官方設定。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此功能僅在 iPad 上為官方設定。"
          }
        }
      }
    },
    "This flag is only enabled on Apple internal or research devices.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This flag is only enabled on Apple internal or research devices."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此标记仅在 Apple 内部设备或安全研究设备上开启。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este indicador solo está activado en dispositivos internos o de investigación de Apple."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این پرچم فقط روی دستگاه‌های داخلی Apple یا دستگاه‌های پژوهش امنیتی فعال است."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフラグはApple社内向けまたはセキュリティ研究用デバイスでのみ有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 플래그는 Apple 내부 기기 또는 보안 연구 기기에서만 켜져 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот флаг включён только на внутренних устройствах Apple или устройствах для исследований безопасности."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işaret yalnızca Apple'ın dahili veya araştırma cihazlarında etkindir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cờ này chỉ được bật trên thiết bị nội bộ của Apple hoặc thiết bị nghiên cứu bảo mật."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此標記僅在 Apple 內部裝置或安全研究裝置上開啟。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此標記僅在 Apple 內部裝置或安全研究裝置上開啟。"
          }
        }
      }
    },
    "This model is not in the reference table. Only internal flags and consistency are checked.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This model is not in the reference table. Only internal flags and consistency are checked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此机型不在参考表中，仅检查内部标记和一致性。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo no está en la tabla de referencia. Solo se comprueban los indicadores internos y la coherencia."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این مدل در جدول مرجع نیست. فقط پرچم‌های داخلی و سازگاری بررسی می‌شوند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモデルは参照表にありません。内部フラグと整合性のみを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모델은 참조 표에 없습니다. 내부 플래그와 일관성만 확인합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этой модели нет в справочной таблице. Проверяются только внутренние флаги и согласованность."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu model referans tablosunda yok. Yalnızca dahili işaretler ve tutarlılık denetlenir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểu máy này không có trong bảng tham chiếu. Chỉ kiểm tra các cờ nội bộ và tính nhất quán."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此機型不在參考表中，僅檢查內部標記和一致性。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此機型不在參考表中，僅檢查內部標記和一致性。"
          }
        }
      }
    },
