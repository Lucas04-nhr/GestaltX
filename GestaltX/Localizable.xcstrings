          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュを消去しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐시를 정리하시겠습니까?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистить кэш?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önbellekler temizlensin mi?"
          }
        },
        "vi": {
          "stringUnit": {
