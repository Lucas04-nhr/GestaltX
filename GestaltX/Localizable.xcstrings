          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "套用前會備份原始啟動畫面。"
          }
        }
      }
    },
    "Only launch images changed by GestaltX will be restored.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only launch images changed by GestaltX will be restored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅还原由 GestaltX 修改的启动图。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se restaurarán las imágenes modificadas por GestaltX."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط تصاویر آغاز تغییرکرده توسط GestaltX بازیابی می‌شوند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GestaltXが変更した起動画面のみ元に戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GestaltX가 변경한 시작 이미지만 복원합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будут восстановлены только изображения запуска, изменённые GestaltX."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca GestaltX'in değiştirdiği başlatma görselleri geri yüklenir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ khôi phục ảnh khởi động do GestaltX thay đổi."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只還原由 GestaltX 修改的啟動畫面。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "僅還原由 GestaltX 修改的啟動畫面。"
          }
        }
      }
    },
    "Launch image saved. Close and reopen the app to see it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch image saved. Close and reopen the app to see it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动图已保存，请关闭并重新打开该 App 查看。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagen guardada. Cierra y vuelve a abrir la app para verla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تصویر آغاز ذخیره شد. برای دیدن آن، برنامه را ببندید و دوباره باز کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動画面を保存しました。アプリを終了してから開き直すと確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 이미지를 저장했습니다. 앱을 닫았다가 다시 열어 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изображение запуска сохранено. Закройте и снова откройте приложение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlatma görseli kaydedildi. Görmek için uygulamayı kapatıp yeniden açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu ảnh khởi động. Đóng rồi mở lại ứng dụng để xem."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動畫面已儲存，請關閉並重新開啟該 App 查看。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動畫面已儲存，請關閉並重新開啟該 App 查看。"
          }
        }
      }
    },
    "Restored. Launch images refreshed by iOS were left unchanged.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restored. Launch images refreshed by iOS were left unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已还原；iOS 重新生成的启动图保持不变。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurado. Las imágenes regeneradas por iOS se conservaron."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بازیابی شد. تصاویر آغاز بازسازی‌شده توسط iOS بدون تغییر باقی ماندند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元に戻しました。iOSが再生成した起動画面は変更していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원했습니다. iOS가 다시 생성한 시작 이미지는 유지했습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановлено. Изображения, пересозданные iOS, оставлены без изменений."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri yüklendi. iOS'in yenilediği başlatma görsellerine dokunulmadı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã khôi phục. Ảnh khởi động do iOS tạo lại được giữ nguyên."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "已還原；iOS 重新產生的啟動畫面保持不變。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "已還原；iOS 重新產生的啟動畫面保持不變。"
          }
        }
      }
    },
    "No launch images found. Open the app once, close it, then read again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No launch images found. Open the app once, close it, then read again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到启动图。请先打开该 App 一次，关闭后重新读取。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron imágenes. Abre la app una vez, ciérrala y vuelve a leer."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تصویر آغاز یافت نشد. برنامه را یک بار باز کنید، ببندید و دوباره بخوانید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動画面が見つかりません。対象のアプリを一度開いて終了し、再読み込みしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 이미지를 찾지 못했습니다. 앱을 한 번 열고 닫은 후 다시 읽으세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изображения запуска не найдены. Откройте приложение один раз, закройте и прочитайте снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlatma görseli bulunamadı. Uygulamayı bir kez açıp kapatın, sonra yeniden okuyun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy ảnh khởi động. Mở ứng dụng một lần, đóng lại rồi đọc lại."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到啟動畫面。請先開啟該 App 一次，關閉後重新讀取。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到啟動畫面。請先開啟該 App 一次，關閉後重新讀取。"
          }
        }
      }
    },
    "The app was reinstalled. Its saved launch images cannot be restored.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app was reinstalled. Its saved launch images cannot be restored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该 App 已重新安装，无法还原之前保存的启动图。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app se ha reinstalado. No se pueden restaurar sus imágenes anteriores."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه دوباره نصب شده است. تصاویر آغاز ذخیره‌شده آن قابل بازیابی نیستند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが再インストールされています。以前に保存した起動画面は復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 재설치되었습니다. 이전에 저장한 시작 이미지를 복원할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение было переустановлено. Его старые изображения запуска нельзя восстановить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama yeniden yüklendi. Kaydedilen başlatma görselleri geri yüklenemiyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng đã được cài lại. Không thể khôi phục ảnh khởi động đã lưu trước đó."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此 App 已重新安裝，無法還原之前儲存的啟動畫面。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此 App 已重新安裝，無法還原先前儲存的啟動畫面。"
          }
        }
      }
    },
    "This image could not be used. Choose another image.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image could not be used. Choose another image."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法使用这张图片，请选择其他图片。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede usar esta imagen. Elige otra."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این تصویر قابل استفاده نیست. تصویر دیگری انتخاب کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像は使用できません。別の画像を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이미지를 사용할 수 없습니다. 다른 이미지를 선택하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось использовать это изображение. Выберите другое."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu görsel kullanılamadı. Başka bir görsel seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể dùng ảnh này. Hãy chọn ảnh khác."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法使用這張圖片，請選擇其他圖片。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法使用這張圖片，請選擇其他圖片。"
          }
        }
      }
    },
    "Importing…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Importing…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在导入…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importando…"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در حال وارد کردن…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポート中…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져오는 중…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импорт…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçe aktarılıyor…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
