    },
    "The original backup is invalid or belongs to another file. It was kept unchanged.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original backup is invalid or belongs to another file. It was kept unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始备份无效或属于其他文件，已保持不变。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia original no es válida o pertenece a otro archivo. Se conservó sin cambios."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخهٔ پشتیبان اصلی نامعتبر است یا به فایل دیگری تعلق دارد. بدون تغییر حفظ شد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のバックアップが無効か、別のファイルのものです。変更せずに保持しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 백업이 유효하지 않거나 다른 파일의 백업입니다. 변경하지 않고 보관했습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходная резервная копия повреждена или относится к другому файлу. Она оставлена без изменений."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özgün yedek geçersiz veya başka bir dosyaya ait. Değişmeden korundu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao lưu gốc không hợp lệ hoặc thuộc tệp khác. Bản sao lưu không bị thay đổi."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "原始備份無效或屬於其他檔案，已保持不變。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "原始備份無效或屬於其他檔案，已保持不變。"
          }
        }
      }
    },
