          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp nén không hợp lệ hoặc vượt quá giới hạn dung lượng."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "壓縮檔無效或超過大小限制。"
          }
