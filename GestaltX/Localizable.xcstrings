    "This only deletes the imported pack from GestaltX. Applied wallpapers will be kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This only deletes the imported pack from GestaltX. Applied wallpapers will be kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只从 GestaltX 删除导入包，已应用的壁纸会保留。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se eliminará el paquete importado de GestaltX. Los fondos aplicados se conservarán."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط بستهٔ واردشده از GestaltX حذف می‌شود. تصاویر زمینهٔ اعمال‌شده باقی می‌مانند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GestaltXから読み込んだパックのみ削除します。適用済みの壁紙は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GestaltX에서 가져온 팩만 삭제합니다. 적용된 배경화면은 유지됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Набор будет удалён только из GestaltX. Применённые обои сохранятся."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, yalnızca içe aktarılan paketi GestaltX'ten siler. Uygulanmış duvar kağıtları korunur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ xóa gói đã nhập khỏi GestaltX. Các hình nền đã áp dụng sẽ được giữ lại."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只會從 GestaltX 刪除匯入套件，已套用的背景圖片會保留。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "只從 GestaltX 刪除匯入套件，已套用的背景圖片會保留。"
          }
        }
      }
    },
