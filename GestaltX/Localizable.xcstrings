      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep a copy. Refresh when ready."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先留一份备份，准备好后再刷新。"
          }
