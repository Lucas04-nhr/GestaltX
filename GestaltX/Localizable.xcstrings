          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir seferde tek MobileGestalt plist'i paylaşın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi lần chỉ chia sẻ một tệp plist MobileGestalt."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
