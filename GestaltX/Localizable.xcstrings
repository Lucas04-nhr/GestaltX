        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleştirme kodu burada, Dynamic Island'da ve bir bildirim olarak görünür."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã ghép nối xuất hiện ở đây, trong Dynamic Island và trong thông báo."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "配對碼會顯示在這裡，也會出現在動態島和通知中。"
          }
        },
        "zh-Hant-TW": {
