    "A backup is created before writing. The result is read back and compared.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A backup is created before writing. The result is read back and compared."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写入前会创建备份，写入后会回读并比较内容。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se crea un respaldo antes de escribir. El resultado se vuelve a leer y se compara."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از نوشتن، نسخهٔ پشتیبان ساخته می‌شود. نتیجه دوباره خوانده و مقایسه می‌شود."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き込み前にバックアップが作成されます。結果を再読み取りして比較します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰기 전에 백업이 생성됩니다. 기록된 결과는 다시 불러와 비교 검증됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед записью создаётся резервная копия. Затем результат считывается и сравнивается."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazmadan önce bir yedek oluşturulur. Sonuç geri okunur ve karşılaştırılır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao lưu được tạo trước khi ghi. Kết quả được đọc lại và so sánh."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "寫入前會創建備份，寫入後會回讀並比較內容。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "寫入前會建立備份，寫入後會回讀並比較內容。"
          }
        }
      }
    },
    "This edits the opened file in GestaltX. Export it to save a copy; the system file is not changed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This edits the opened file in GestaltX. Export it to save a copy; the system file is not changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅编辑 GestaltX 中打开的文件。请导出以保存副本，系统文件不会被修改。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto edita el archivo abierto en GestaltX. Expórtalo para guardar una copia; el archivo del sistema no se modificará."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار فایل بازشده در GestaltX را ویرایش می‌کند. برای نگه‌داشتن کپی، آن را صادر کنید؛ فایل سیستم تغییر نمی‌کند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GestaltXで開いたファイルを編集します。コピーを保存するには書き出してください。システムファイルは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GestaltX에 열려 있는 파일만 수정합니다. 사본을 보관하려면 내보내기를 누르십시오. 시스템 파일은 변경되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменяется файл, открытый в GestaltX. Экспортируйте его, чтобы сохранить копию. Системный файл не изменяется."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, açılan dosyayı GestaltX içinde düzenler. Kopya kaydetmek için dışa aktarın; sistem dosyası değişmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này chỉnh sửa tệp đang mở trong GestaltX. Hãy xuất để lưu một bản sao; tệp hệ thống không thay đổi."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "僅編輯 GestaltX 中打開的文件。請導出以保存副本，系統文件不會被修改。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "僅編輯 GestaltX 中開啟的檔案。請匯出以儲存副本，系統檔案不會被修改。"
          }
        }
      }
    },
