        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "壓縮檔無效或超過大小限制。"
          }
        }
      }
    },
    "The device container could not be located. Read again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device container could not be located. Read again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能定位设备容器，请重新读取。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró el contenedor del dispositivo. Vuelve a leer."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "محفظه دستگاه پیدا نشد. دوباره بخوانید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
