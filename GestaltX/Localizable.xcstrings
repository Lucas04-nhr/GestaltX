    "If GestaltX is useful to you, a GitHub star helps a lot.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If GestaltX is useful to you, a GitHub star helps a lot."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果它对你有帮助，去 GitHub 点个 Star 支持一下。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si GestaltX te resulta útil, una estrella en GitHub ayuda mucho."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر GestaltX برایتان مفید است، یک ستاره در GitHub کمک زیادی می‌کند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "役に立っているなら、GitHub でスターを付けていただけると助かります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유용하게 쓰고 계시다면 GitHub에서 스타를 눌러 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если GestaltX полезен, звезда на GitHub очень поможет."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GestaltX size yararlıysa, GitHub'da bir yıldız bize çok yardımcı olur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu GestaltX hữu ích với bạn, một ngôi sao trên GitHub sẽ giúp ích rất nhiều."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如果它對你有幫助，歡迎到 GitHub 按個 Star 支持一下。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "如果它對你有幫助，歡迎到 GitHub 按個 Star 支持一下。"
          }
        }
      }
    },
