        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法解析此设备的 MobileGestalt 缓存布局。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede resolver la estructura de caché de MobileGestalt de este dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساختار حافظهٔ نهان MobileGestalt این دستگاه قابل تشخیص نیست."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
