          "stringUnit": {
            "state": "translated",
            "value": "生成モデル機能を設定します。利用可能性はハードウェア、地域、Appleのサービスにも依存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생성형 모델 기능 플래그를 설정합니다. 실제 사용 가능 여부는 기기 하드웨어, 지역 및 Apple 서비스 지원 여부에 따라 달라집니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установить флаг генеративных моделей. Доступность также зависит от оборудования, региона и сервисов Apple."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üretken modeller yeteneğini ayarlar. Kullanılabilirlik ayrıca donanıma, bölgeye ve Apple hizmetlerine bağlıdır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt cờ mô hình tạo sinh. Khả năng sử dụng còn tùy thuộc vào phần cứng, vùng và dịch vụ Apple."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "設定生成式模型功能標記，可用性仍取決於硬件、地區與 Apple 服務。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "設定生成式模型功能標記，可用性仍取決於硬體、地區與 Apple 服務。"
          }
        }
      }
    },
