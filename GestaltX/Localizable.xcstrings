    "Share one MobileGestalt plist at a time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share one MobileGestalt plist at a time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请每次分享一个 MobileGestalt plist 文件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte un solo archivo plist de MobileGestalt a la vez."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر بار یک فایل plist مربوط به MobileGestalt را به اشتراک بگذارید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度に共有できるMobileGestalt plistは1つだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MobileGestalt plist 파일은 한 번에 하나씩만 공유하여 가져올 수 있습니다."
          }
        },
        "ru": {
