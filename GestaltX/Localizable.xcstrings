            "value": "삭제된 파일 데이터: %@. 오류: %lld개. 건너뛴 링크 또는 특수 파일: %lld개."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалено данных файлов: %@. Ошибок: %lld. Пропущено ссылок или специальных файлов: %lld."
          }
        },
        "tr": {
          "stringUnit": {
