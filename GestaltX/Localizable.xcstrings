    "Leave the name empty to show the backup's type instead.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave the name empty to show the backup's type instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称留空时显示备份类型。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja el nombre vacío para mostrar el tipo de respaldo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای نمایش نوع نسخهٔ پشتیبان، نام را خالی بگذارید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
