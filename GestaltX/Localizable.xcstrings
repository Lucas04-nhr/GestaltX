    "Some files could not be restored. The backup has been kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some files could not be restored. The backup has been kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分文件未能恢复，备份已保留。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron restaurar algunos archivos. Se ha conservado la copia."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برخی فایل‌ها بازگردانی نشدند. نسخه پشتیبان نگه داشته شده است."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のファイルを元に戻せませんでした。バックアップは保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 파일을 복원하지 못했습니다. 백업은 보관됩니다."
