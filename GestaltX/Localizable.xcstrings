          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem ayarları dosyası geçerli bir sözlük değil."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp cài đặt hệ thống không phải từ điển hợp lệ. Đã dừng thao tác."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "系統設定檔案不是有效的字典，已停止操作。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
