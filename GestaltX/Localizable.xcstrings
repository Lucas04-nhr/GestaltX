        }
      }
    },
    "This backup could not be found. Refresh the list and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backup could not be found. Refresh the list and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到这个备份，请刷新列表后重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró este respaldo. Actualiza la lista e inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این نسخهٔ پشتیبان پیدا نشد. فهرست را تازه کنید و دوباره امتحان کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックアップが見つかりません。リストを更新して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 백업을 찾을 수 없습니다. 목록을 새로 고친 후 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта резервная копия не найдена. Обновите список и повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yedek bulunamadı. Listeyi yenileyip tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy bản sao lưu này. Hãy làm mới danh sách và thử lại."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到這個備份，請刷新列表後再試一次。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到這個備份，請重新整理列表後再試一次。"
          }
        }
      }
    },
    "Import Backup Archive": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import Backup Archive"
          }
        },
        "zh-Hans": {
