        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل فشرده شامل مسیرها یا پیوندهای ناامن است."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブに安全でないパスやリンクが含まれています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "압축 파일에 안전하지 않은 경로나 링크가 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Архив содержит небезопасные пути или ссылки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşiv güvenli olmayan yollar veya bağlantılar içeriyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp nén chứa đường dẫn hoặc liên kết không an toàn."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "壓縮檔包含不安全的路徑或連結。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "壓縮檔包含不安全的路徑或連結。"
          }
        }
      }
    },
    "The archive is invalid or exceeds the size limit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The archive is invalid or exceeds the size limit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压缩包无效或超过大小限制。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo no es válido o supera el límite de tamaño."
