            "state": "translated",
            "value": "正在輸入⋯"
          }
        }
      }
    },
    "Share one file at a time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share one file at a time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次仅分享一个文件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte un archivo a la vez."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر بار فقط یک فایل را به اشتراک بگذارید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度に共有できるファイルは1つです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번에 파일 하나만 공유하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляйте по одному файлу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir seferde tek dosya paylaşın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi lần chỉ chia sẻ một tệp."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "每次只分享一個檔案。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "每次僅分享一個檔案。"
          }
        }
      }
    },
    "Choose a MobileGestalt plist or a wallpaper pack.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a MobileGestalt plist or a wallpaper pack."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择 MobileGestalt plist 或壁纸包。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un plist de MobileGestalt o un paquete de fondos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک plist از MobileGestalt یا بسته تصویر زمینه انتخاب کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MobileGestaltのplistまたは壁紙パックを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MobileGestalt plist 또는 배경화면 팩을 선택하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите plist MobileGestalt или набор обоев."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir MobileGestalt plist dosyası ya da duvar kağıdı paketi seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn plist MobileGestalt hoặc gói hình nền."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇 MobileGestalt plist 或背景圖片套件。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇 MobileGestalt plist 或背景圖片套件。"
          }
        }
      }
    },
    "Open GestaltX to confirm importing the wallpaper pack.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open GestaltX to confirm importing the wallpaper pack."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 GestaltX 以确认导入壁纸包。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre GestaltX para confirmar la importación del paquete de fondos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای تأیید وارد کردن بسته تصویر زمینه، GestaltX را باز کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GestaltXを開いて壁紙パックのインポートを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GestaltX를 열어 배경화면 팩 가져오기를 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте GestaltX, чтобы подтвердить импорт набора обоев."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duvar kağıdı paketinin aktarımını onaylamak için GestaltX'i açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở GestaltX để xác nhận nhập gói hình nền."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 GestaltX 以確認匯入背景圖片套件。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "打開 GestaltX 以確認輸入背景圖片套件。"
          }
        }
      }
    },
    "Import this wallpaper pack? It will be added to Wallpaper Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import this wallpaper pack? It will be added to Wallpaper Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入这个壁纸包？导入后将添加到“壁纸设置”。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Importar este paquete? Se añadirá a Ajustes de fondos de pantalla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این بسته تصویر زمینه وارد شود؟ بسته به تنظیمات تصویر زمینه اضافه خواهد شد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この壁紙パックをインポートしますか？「壁紙設定」に追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 배경화면 팩을 가져올까요? 배경화면 설정에 추가됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортировать этот набор обоев? Он появится в настройках обоев."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu duvar kağıdı paketi içe aktarılsın mı? Duvar Kağıdı Ayarları'na eklenecek."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập gói hình nền này? Gói sẽ được thêm vào Cài đặt hình nền."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "要匯入此背景圖片套件嗎？匯入後會加入「背景圖片設定」。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "要輸入此背景圖片套件嗎？輸入後會加入「背景圖片設定」。"
          }
        }
      }
    },
    "A shared file is waiting. Save or discard your current changes, then import it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A shared file is waiting. Save or discard your current changes, then import it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有分享的文件等待导入，请先保存或放弃当前更改。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay un archivo compartido pendiente. Guarda o descarta los cambios actuales y después impórtalo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک فایل اشتراک‌گذاری‌شده منتظر است. ابتدا تغییرات فعلی را ذخیره یا لغو کنید، سپس آن را وارد کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有されたファイルが待機しています。現在の変更を保存するか破棄してからインポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유된 파일이 대기 중입니다. 현재 변경 사항을 저장하거나 취소한 후 가져오세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получен файл. Сохраните или отмените текущие изменения, затем импортируйте его."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşılmış bir dosya bekliyor. Geçerli değişikliklerinizi kaydedin veya geri alın, sonra onu içe aktarın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có tệp chia sẻ đang chờ. Hãy lưu hoặc bỏ các thay đổi hiện tại rồi nhập tệp."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "有分享的檔案等待匯入，請先儲存或放棄目前的變更。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "有分享的檔案等待輸入，請先儲存或放棄目前的更動。"
          }
        }
      }
    },
    "Import a .tendies or .zip wallpaper pack. You can also share it to GestaltX.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import a .tendies or .zip wallpaper pack. You can also share it to GestaltX."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入 .tendies 或 .zip 壁纸包，也可通过分享发送到 GestaltX。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa un paquete .tendies o .zip, o compártelo con GestaltX."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بسته تصویر زمینه با قالب .tendies یا .zip را وارد کنید یا آن را با GestaltX به اشتراک بگذارید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ".tendiesまたは.zipの壁紙パックをインポートします。共有メニューからGestaltXに送ることもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ".tendies 또는 .zip 배경화면 팩을 가져오거나 GestaltX로 공유하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортируйте набор обоев .tendies или .zip либо отправьте его в GestaltX через меню «Поделиться»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ".tendies veya .zip duvar kağıdı paketi içe aktarın. Bunu GestaltX'e paylaşarak da gönderebilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập gói hình nền .tendies hoặc .zip, hoặc chia sẻ gói đó đến GestaltX."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入 .tendies 或 .zip 背景圖片套件，亦可透過分享傳送至 GestaltX。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入 .tendies 或 .zip 背景圖片套件，也可透過分享傳送至 GestaltX。"
          }
        }
      }
    },
