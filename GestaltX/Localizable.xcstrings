        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her yazmadan önce bir yedek oluşturulur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao lưu được tạo trước mỗi lần ghi."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "每次寫入前會自動備份。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "每次寫入前會自動備份。"
          }
        }
