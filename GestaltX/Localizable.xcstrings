        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک جفت‌سازی یا ضبط دیگر در حال اجراست."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のペアリングまたはキャプチャが実行中です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 페어링 또는 캡처가 이미 실행 중입니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сопряжение или захват уже выполняется."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir eşleştirme veya yakalama zaten sürüyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã có một phiên ghép nối hoặc chụp đang chạy."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "已有配對或擷取正在進行。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "已有配對或擷取正在進行。"
          }
        }
      }
    },
    "The device console is not available in this build.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device console is not available in this build."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本未启用设备控制台。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La consola del dispositivo no está disponible en esta compilación."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کنسول دستگاه در این نسخه در دسترس نیست."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドではデバイスコンソールを利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빌드에서는 기기 콘솔을 사용할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Консоль устройства недоступна в этой сборке."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz konsolu bu derlemede kullanılamıyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bảng điều khiển thiết bị không có trong bản dựng này."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本未啟用裝置主控台。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本未啟用裝置主控台。"
          }
        }
      }
    },
    "Build the GXDeviceConsole library and enable it to use pairing and capture.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build the GXDeviceConsole library and enable it to use pairing and capture."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要构建并启用 GXDeviceConsole 库后才能配对和采集。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compila y habilita la biblioteca GXDeviceConsole para usar emparejamiento y captura."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای استفاده از جفت‌سازی و ضبط، کتابخانهٔ GXDeviceConsole را بسازید و فعال کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GXDeviceConsole ライブラリをビルドして有効にすると、ペアリングとキャプチャを使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GXDeviceConsole 라이브러리를 빌드하고 활성화하면 페어링과 캡처를 사용할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соберите и включите библиотеку GXDeviceConsole, чтобы использовать сопряжение и захват."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleştirme ve yakalamayı kullanmak için GXDeviceConsole kitaplığını derleyin ve etkinleştirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dựng và bật thư viện GXDeviceConsole để dùng ghép nối và chụp."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "需要建置並啟用 GXDeviceConsole 程式庫後才能配對和擷取。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "需要建置並啟用 GXDeviceConsole 程式庫後才能配對和擷取。"
          }
        }
      }
    },
    "Pair this device once in Settings › Privacy & Security › Developer Mode › Pair with the broadcast host. The exact path can vary by iOS version.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair this device once in Settings › Privacy & Security › Developer Mode › Pair with the broadcast host. The exact path can vary by iOS version."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置 › 隐私与安全性 › 开发者模式 › 与广播的主机配对”中配对一次。具体路径因 iOS 版本而异。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empareja una vez en Ajustes › Privacidad y seguridad › Modo de desarrollador › Emparejar con el host de difusión. La ruta exacta varía según la versión de iOS."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک‌بار در تنظیمات › حریم خصوصی و امنیت › حالت توسعه‌دهنده › جفت‌سازی با میزبان پخش، جفت‌سازی کنید. مسیر دقیق بسته به نسخهٔ iOS فرق می‌کند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定 › プライバシーとセキュリティ › デベロッパモード › ブロードキャストホストとペアリング」で一度ペアリングします。正確な場所は iOS のバージョンにより異なります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘설정 › 개인정보 보호 및 보안 › 개발자 모드 › 브로드캐스트 호스트와 페어링’에서 한 번 페어링하세요. 정확한 경로는 iOS 버전에 따라 다를 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполните сопряжение один раз в «Настройки › Конфиденциальность и безопасность › Режим разработчика › Сопряжение с вещающим хостом». Точный путь зависит от версии iOS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazı bir kez Ayarlar › Gizlilik ve Güvenlik › Geliştirici Modu › Yayın yapan cihazla eşleştir bölümünde eşleştirin. Tam yol iOS sürümüne göre değişebilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghép nối một lần trong Cài đặt › Quyền riêng tư & Bảo mật › Chế độ nhà phát triển › Ghép nối với máy chủ phát. Đường dẫn chính xác tùy theo phiên bản iOS."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在「設定 › 私隱與保安 › 開發者模式 › 與廣播的主機配對」中配對一次。實際路徑因 iOS 版本而異。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "在「設定 › 隱私權與安全性 › 開發者模式 › 與廣播的主機配對」中配對一次。實際路徑因 iOS 版本而異。"
          }
        }
      }
    },
    "Start a loopback VPN (e.g. LocalDevVPN), then start capture and trigger a notification in the target app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a loopback VPN (e.g. LocalDevVPN), then start capture and trigger a notification in the target app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先打开回路 VPN（如 LocalDevVPN），再开始采集，然后在目标 App 里触发一条通知。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia una VPN de bucle (p. ej. LocalDevVPN), luego inicia la captura y genera una notificación en la app objetivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ابتدا یک VPN لوپ‌بک (مثل LocalDevVPN) را روشن کنید، سپس ضبط را شروع کرده و در برنامهٔ موردنظر یک اعلان ایجاد کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずループバック VPN（LocalDevVPN など）を開始し、キャプチャを開始して対象アプリで通知を発生させます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 루프백 VPN(예: LocalDevVPN)을 켠 뒤 캡처를 시작하고 대상 앱에서 알림을 발생시키세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите петлевой VPN (например, LocalDevVPN), затем начните захват и вызовите уведомление в нужном приложении."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir loopback VPN başlatın (örn. LocalDevVPN), sonra yakalamayı başlatın ve hedef uygulamada bir bildirim tetikleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật VPN loopback (vd. LocalDevVPN), rồi bắt đầu chụp và kích hoạt một thông báo trong ứng dụng mục tiêu."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "先開啟回路 VPN（例如 LocalDevVPN），再開始擷取，然後在目標 App 中觸發一則通知。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "先開啟回路 VPN（例如 LocalDevVPN），再開始擷取，然後在目標 App 中觸發一則通知。"
          }
        }
      }
    },
    "These filenames were captured from notifications. Add a same-name audio to override them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These filenames were captured from notifications. Add a same-name audio to override them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些文件名来自通知采集。添加同名音频即可覆盖。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos nombres de archivo se capturaron de notificaciones. Añade un audio con el mismo nombre para sustituirlos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این نام‌پرونده‌ها از اعلان‌ها ثبت شده‌اند. برای جایگزینی، صدایی هم‌نام اضافه کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのファイル名は通知から取得しました。同名のオーディオを追加すると上書きできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일 이름은 알림에서 캡처되었습니다. 같은 이름의 오디오를 추가하면 대체됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти имена файлов получены из уведомлений. Добавьте аудио с тем же именем, чтобы заменить их."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya adları bildirimlerden yakalandı. Geçersiz kılmak için aynı ada sahip bir ses ekleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tên tệp này được chụp từ thông báo. Thêm âm thanh cùng tên để ghi đè."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "這些檔名來自通知擷取。加入同名音訊即可覆寫。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "這些檔名來自通知擷取。加入同名音訊即可覆寫。"
          }
        }
      }
    },
    "A same-name audio will be written to this app's Library/Sounds so the system uses it instead of the bundled sound.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A same-name audio will be written to this app's Library/Sounds so the system uses it instead of the bundled sound."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会在该 App 的 Library/Sounds 写入同名音频，系统会优先使用它，而不是包内音频。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se escribirá un audio con el mismo nombre en Library/Sounds de esta app para que el sistema lo use en lugar del sonido incluido."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صدایی هم‌نام در Library/Sounds این برنامه نوشته می‌شود تا سیستم به‌جای صدای همراه، از آن استفاده کند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリの Library/Sounds に同名のオーディオを書き込み、バンドル内の音の代わりにシステムがそれを使うようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱의 Library/Sounds에 같은 이름의 오디오를 기록해 시스템이 번들 사운드 대신 그것을 사용하도록 합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудио с тем же именем будет записано в Library/Sounds этого приложения, чтобы система использовала его вместо встроенного звука."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı ada sahip bir ses, bu uygulamanın Library/Sounds klasörüne yazılır; böylece sistem paketteki sesin yerine onu kullanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một tệp âm thanh cùng tên sẽ được ghi vào Library/Sounds của ứng dụng này để hệ thống dùng nó thay cho âm đi kèm."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "將向該 App 的 Library/Sounds 寫入同名音訊，讓系統改用它而非套件內音訊。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "將向該 App 的 Library/Sounds 寫入同名音訊，讓系統改用它而非套件內音訊。"
          }
        }
      }
    },
