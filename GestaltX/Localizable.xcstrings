          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazma doğrulandı. Bazı özellikler cihazın yeniden başlatılmasını gerektirir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xác minh nội dung ghi. Một số tính năng cần khởi động lại thiết bị."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "寫入已驗證。部分功能需要重新啓動設備才能生效。"
