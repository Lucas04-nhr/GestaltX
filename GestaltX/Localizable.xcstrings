          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes del sistema han cambiado. Vuelve a leerlos antes de aplicar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تنظیمات سیستم تغییر کرده‌اند. پیش از اعمال، آن‌ها را دوباره بخوانید."
          }
