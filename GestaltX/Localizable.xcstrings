    "Change the SRD capability flag. This does not turn the device into an Apple SRD.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change the SRD capability flag. This does not turn the device into an Apple SRD."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改 SRD 功能标记，不会将设备变成 Apple 官方安全研究设备。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar la bandera de función SRD. Esto no convierte el dispositivo en un Apple SRD."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پرچم SRD را تغییر دهید. این کار دستگاه را به یک Apple SRD واقعی تبدیل نمی‌کند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SRD機能フラグを変更します。デバイスがApple SRDになるわけではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안 리서치 기기 기능 플래그를 변경합니다. 설정한다고 해서 일반 기기가 실제 Apple 보안 리서치 기기로 변환되지는 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменить флаг SRD. Это не превращает устройство в официальное Apple SRD."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SRD yetenek bayrağını değiştirir. Bu, cihazı bir Apple SRD'ye dönüştürmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổi cờ SRD. Thao tác này không biến thiết bị thành Apple SRD."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "更改 SRD 功能標記，不會將設備變成 Apple 官方安全研究設備。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "更改 SRD 功能標記，不會將裝置變成 Apple 官方安全研究裝置。"
          }
        }
      }
    },
