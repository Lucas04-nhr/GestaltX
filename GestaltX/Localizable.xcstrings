        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法找到裝置容器，請重新讀取。"
          }
        }
      }
    },
    "The files changed. Read again before applying.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The files changed. Read again before applying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件已变化，请重新读取后再应用。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos han cambiado. Vuelve a leer antes de aplicar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل‌ها تغییر کرده‌اند. پیش از اعمال، دوباره بخوانید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
