    "Loopback VPN is not reachable. Open LocalDevVPN, wait until it connects, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopback VPN is not reachable. Open LocalDevVPN, wait until it connects, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回路 VPN 不可达。请打开 LocalDevVPN，等它连接成功后重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La VPN de bucle local no está disponible. Abre LocalDevVPN, espera a que conecte y vuelve a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN حلقه‌ای در دسترس نیست. LocalDevVPN را باز کنید، منتظر اتصال بمانید و دوباره تلاش کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ループバック VPN に接続できません。LocalDevVPN を開いて接続を待ち、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루프백 VPN에 연결할 수 없습니다. LocalDevVPN을 열고 연결될 때까지 기다린 후 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopback VPN недоступен. Откройте LocalDevVPN, дождитесь подключения и повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopback VPN'e erişilemiyor. LocalDevVPN'i açın, bağlanmasını bekleyin, sonra tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không kết nối được VPN vòng lặp. Hãy mở LocalDevVPN, đợi kết nối rồi thử lại."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "回路 VPN 無法連線。請開啟 LocalDevVPN，等它連線成功後再試一次。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "回路 VPN 無法連線。請開啟 LocalDevVPN，等它連線成功後再試一次。"
          }
        }
      }
    },
    "The saved pairing file is missing. Pair this iPhone again before capturing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved pairing file is missing. Pair this iPhone again before capturing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对文件不见了，请重新配对这个 iPhone 再开始采集。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta el archivo de emparejamiento guardado. Vuelve a emparejar este iPhone antes de capturar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل جفت‌سازی ذخیره‌شده پیدا نشد. پیش از ضبط، این iPhone را دوباره جفت کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたペアリングファイルがありません。キャプチャの前にこの iPhone を再ペアリングしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 페어링 파일이 없습니다. 캡처하기 전에 이 iPhone을 다시 페어링하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённый файл сопряжения отсутствует. Сопрягите этот iPhone заново перед захватом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilen eşleştirme dosyası eksik. Yakalamadan önce bu iPhone'u yeniden eşleştirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy tệp ghép nối đã lưu. Hãy ghép nối lại iPhone này trước khi ghi."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "配對檔案不見了，請重新配對這台 iPhone 再開始擷取。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "配對檔案不見了，請重新配對這台 iPhone 再開始擷取。"
          }
        }
      }
    },
