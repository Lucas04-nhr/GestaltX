          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục danh tính phần cứng"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "還原硬體身分"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "還原硬體身分"
          }
        }
      }
    },
    "Restore only the original product, board, CPU and model number from this backup. AI and region settings are kept. Restart and test Face ID and dictation afterward.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore only the original product, board, CPU and model number from this backup. AI and region settings are kept. Restart and test Face ID and dictation afterward."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅从此备份恢复原始产品标识、板号、CPU 和监管型号，保留 AI 与地区设置。随后请完整重启并测试 Face ID 与听写。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura solo el producto, la placa, la CPU y el número de modelo originales de esta copia. Los ajustes de IA y región se conservan. Reinicia y prueba Face ID y el dictado después."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط محصول، برد، CPU و شماره مدل اصلی را از این پشتیبان بازیابی کنید. تنظیمات هوش مصنوعی و منطقه حفظ می‌شوند. پس از آن دستگاه را راه‌اندازی مجدد کرده و Face ID و دیکته را آزمایش کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックアップから元の製品・ボード・CPU・モデル番号のみを復元します。AI と地域の設定は保持されます。再起動後に Face ID と音声入力をお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 백업에서 원래 제품, 보드, CPU 및 모델 번호만 복원합니다. AI 및 지역 설정은 유지됩니다. 재시동 후 Face ID와 받아쓰기를 테스트하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановить из этой резервной копии только исходные продукт, плату, CPU и номер модели. Настройки ИИ и региона сохраняются. После этого перезагрузите устройство и проверьте Face ID и диктовку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yedekten yalnızca özgün ürün, kart, CPU ve model numarasını geri yükler. AI ve bölge ayarları korunur. Sonrasında yeniden başlatın ve Face ID ile dikteyi test edin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ khôi phục sản phẩm, bo mạch, CPU và số model gốc từ bản sao lưu này. Cài đặt AI và khu vực được giữ nguyên. Khởi động lại và kiểm tra Face ID cùng tính năng đọc chính tả sau đó."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "僅從此備份還原原始產品、主機板、CPU 與型號。AI 與地區設定會保留。完成後請重新啟動並測試 Face ID 與聽寫。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "僅從此備份還原原始產品、主機板、CPU 與型號。AI 與地區設定會保留。完成後請重新啟動並測試 Face ID 與聽寫。"
          }
        }
      }
    },
    "A verified original hardware backup matching this device and cache is required.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A verified original hardware backup matching this device and cache is required."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要经过验证且与当前设备和缓存匹配的原始硬件备份。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita una copia de seguridad original del hardware verificada y compatible con este dispositivo y caché."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به یک پشتیبان اصلی سخت‌افزار تأییدشده که با این دستگاه و کش مطابقت دارد نیاز است."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスとキャッシュに一致する、検証済みの元のハードウェアバックアップが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기 및 캐시와 일치하는 검증된 원본 하드웨어 백업이 필요합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется проверенная исходная резервная копия оборудования, соответствующая этому устройству и кэшу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazla ve önbellekle eşleşen, doğrulanmış özgün bir donanım yedeği gerekir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần bản sao lưu phần cứng gốc đã xác minh, khớp với thiết bị và bộ nhớ đệm này."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "需要一份與目前裝置和快取相符且已驗證的原始硬體備份。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "需要一份與目前裝置和快取相符且已驗證的原始硬體備份。"
          }
        }
      }
    },
