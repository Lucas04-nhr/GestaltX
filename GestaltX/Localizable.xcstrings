    "No saved original was found for this sound. The app may have replaced it after the last edit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No saved original was found for this sound. The app may have replaced it after the last edit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
