    "Make your device your own.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make your device your own."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让设备更合你意。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz que tu dispositivo sea verdaderamente tuyo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دستگاه را به دلخواه خود تنظیم کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスを自分らしくカスタマイズしましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기를 원하는 대로 맞춤 설정해 보세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте устройство под себя."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazınızı kendinize göre özelleştirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tùy chỉnh thiết bị theo cách của bạn."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "讓設備更合你意。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "讓裝置更合你意。"
          }
        }
      }
