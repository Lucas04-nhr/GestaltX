          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamadan önce özgün başlatma görsellerinin yedeği alınır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh khởi động gốc sẽ được sao lưu trước khi áp dụng."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
