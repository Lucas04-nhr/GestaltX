          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos de archivos eliminados: %@. Errores: %lld. Enlaces o archivos especiales omitidos: %lld."
          }
        },
        "fa": {
          "stringUnit": {
