    "This format cannot be converted. Import audio with the same format, sample rate and channel count.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This format cannot be converted. Import audio with the same format, sample rate and channel count."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此格式暂不支持转换，请导入格式、采样率及声道数相同的音频。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede convertir este formato. Importa audio con el mismo formato, frecuencia de muestreo y número de canales."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدیل این قالب ممکن نیست. صدایی با همان قالب، نرخ نمونه‌برداری و تعداد کانال وارد کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この形式は変換できません。形式、サンプルレート、チャンネル数が同じ音声を読み込んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 형식은 변환할 수 없습니다. 형식, 샘플률, 채널 수가 같은 오디오를 가져오세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот формат нельзя преобразовать. Импортируйте аудио с тем же форматом, частотой дискретизации и числом каналов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu biçim dönüştürülemiyor. Aynı biçimde, örnekleme hızında ve kanal sayısında bir ses aktarın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể chuyển đổi định dạng này. Hãy nhập âm thanh có cùng định dạng, tần số lấy mẫu và số kênh."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此格式暫不支援轉換，請匯入格式、取樣率及聲道數相同的音訊。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此格式暫不支援轉換，請匯入格式、取樣率及聲道數相同的音訊。"
          }
        }
      }
    },
