            "value": "Bu cihazın ABD modeli, donanım modeline ve özgün model numarasına göre bulunur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mẫu Mỹ của thiết bị này được tra cứu từ mẫu phần cứng và số kiểu máy gốc."
          }
        },
        "zh-Hant-HK": {
