    "Restore this backup?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore this backup?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复这个备份？"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Restaurar este respaldo?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این نسخهٔ پشتیبان بازیابی شود؟"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックアップを復元しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 백업을 복원하시겠습니까?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановить эту резервную копию?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yedek geri yüklensin mi?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục bản sao lưu này?"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復這個備份？"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復這個備份？"
          }
        }
      }
    },
    "The current document is backed up first. Device restores are verified after writing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current document is backed up first. Device restores are verified after writing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会先备份当前文稿。本机恢复会在写入后进行验证。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero se respalda el documento actual. Las restauraciones del dispositivo se verifican después de escribir."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ابتدا از سند فعلی پشتیبان گرفته می‌شود. بازیابی روی دستگاه پس از نوشتن تأیید می‌شود."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初に現在のドキュメントをバックアップします。デバイスの復元は書き込み後に検証されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원하기 전 현재 상태의 문서를 먼저 백업합니다. 기기 복원은 쓰기 작업 후 정상적으로 적용되었는지 검증됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала создаётся копия текущего документа. Восстановление на устройстве проверяется после записи."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce geçerli belgenin yedeği alınır. Cihaz geri yüklemeleri yazmadan sonra doğrulanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài liệu hiện tại được sao lưu trước. Việc khôi phục thiết bị được xác minh sau khi ghi."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "會先備份當前文稿。本機恢復會在寫入後進行驗證。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "會先備份當前文稿。本機恢復會在寫入後進行驗證。"
          }
        }
      }
    },
