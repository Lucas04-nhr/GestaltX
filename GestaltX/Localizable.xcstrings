    "Stage %lld Fixes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stage %lld Fixes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂存 %lld 项修正"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparar %lld correcciones"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آماده‌سازی %lld اصلاح"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld件の修正を保留"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수정 사항 %lld개 대기"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подготовить исправления: %lld"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Düzeltmeyi Hazırla"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuẩn bị %lld bản sửa"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "暫存 %lld 項修正"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "暫存 %lld 項修正"
          }
        }
      }
    },
    "Fixes are staged first. Review and apply them like any other change. A backup is created before writing. Possibly unofficial items are not selected by default.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixes are staged first. Review and apply them like any other change. A backup is created before writing. Possibly unofficial items are not selected by default."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修正会先暂存，像其他更改一样确认后再应用，写入前会自动备份。“可能非官方”的项目默认不勾选。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las correcciones se preparan primero. Revísalas y aplícalas como cualquier otro cambio. Se crea un respaldo antes de escribir. Los elementos posiblemente no oficiales no se seleccionan de forma predeterminada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اصلاح‌ها ابتدا آماده می‌شوند. آن‌ها را مانند هر تغییر دیگری بازبینی و اعمال کنید. پیش از نوشتن، نسخهٔ پشتیبان ساخته می‌شود. موارد «احتمالاً غیررسمی» به‌طور پیش‌فرض انتخاب نشده‌اند."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修正はまず保留されます。他の変更と同じように確認して適用してください。書き込む前にバックアップが作成されます。「非公式の可能性あり」の項目はデフォルトで選択されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수정 사항은 먼저 대기 상태가 됩니다. 다른 변경 사항처럼 검토한 뒤 적용하세요. 기록 전에 백업이 생성됩니다. '비공식일 수 있음' 항목은 기본적으로 선택되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исправления сначала подготавливаются. Проверьте и примените их, как любые другие изменения. Перед записью создаётся резервная копия. Элементы «Возможно, неофициально» по умолчанию не выбраны."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzeltmeler önce hazırlanır. Bunları diğer değişiklikler gibi gözden geçirip uygulayın. Yazmadan önce bir yedek oluşturulur. Muhtemelen resmi olmayan öğeler varsayılan olarak seçilmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bản sửa được chuẩn bị trước. Xem lại và áp dụng như mọi thay đổi khác. Một bản sao lưu được tạo trước khi ghi. Các mục có thể không chính thức không được chọn theo mặc định."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "修正會先暫存，像其他更改一樣確認後再應用，寫入前會自動備份。「可能非官方」的項目預設不勾選。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "修正會先暫存，像其他更改一樣確認後再應用，寫入前會自動備份。「可能非官方」的項目預設不勾選。"
          }
        }
      }
    },
