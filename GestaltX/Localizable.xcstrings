          "stringUnit": {
            "state": "translated",
            "value": "A backup is created before each write."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次写入前会自动备份。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se crea un respaldo antes de cada escritura."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از هر بار نوشتن، نسخهٔ پشتیبان ساخته می‌شود."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き込みの前に毎回バックアップが作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰기 작업 전에 항상 백업이 생성됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
