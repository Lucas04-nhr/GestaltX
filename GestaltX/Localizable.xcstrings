        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tùy chọn này thay đổi các byte bộ nhớ đệm không liên quan."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
