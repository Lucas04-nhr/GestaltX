          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró la copia original de este sonido. Es posible que la app lo haya reemplazado después de la última edición."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخه اصلی این صدا پیدا نشد. ممکن است برنامه پس از آخرین ویرایش آن را جایگزین کرده باشد."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサウンドの元のバックアップが見つかりません。前回の編集後に App が置き換えた可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사운드의 원본 백업을 찾을 수 없습니다. 마지막 편집 후 App이 파일을 교체했을 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходная копия этого звука не найдена. Возможно, приложение заменило файл после последнего изменения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ses için kaydedilmiş özgün kayıt bulunamadı. Uygulama, son düzenlemeden sonra onu değiştirmiş olabilir."
