    "Set SiriMode to 2 without spoofing hardware. Experimental; resource downloads and availability are not guaranteed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set SiriMode to 2 without spoofing hardware. Experimental; resource downloads and availability are not guaranteed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 SiriMode 设为 2，不伪装硬件。此功能为实验性质，不保证资源下载或功能可用。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece SiriMode en 2 sin falsear el hardware. Experimental; no se garantizan las descargas de recursos ni la disponibilidad."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "SiriMode را بدون جعل سخت‌افزار روی 2 تنظیم می‌کند. آزمایشی است؛ بارگیری منابع و دسترسی تضمین نمی‌شود."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハードウェアを偽装せずに SiriMode を 2 に設定します。実験的機能であり、リソースのダウンロードや利用は保証されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하드웨어를 위장하지 않고 SiriMode를 2로 설정합니다. 실험적 기능이며 리소스 다운로드와 사용 가능 여부는 보장되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устанавливает SiriMode в 2 без подмены оборудования. Экспериментальная функция; загрузка ресурсов и доступность не гарантируются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SiriMode'u donanımı taklit etmeden 2'ye ayarlar. Deneyseldir; kaynak indirmeleri ve kullanılabilirlik garanti edilmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt SiriMode thành 2 mà không giả mạo phần cứng. Đây là tính năng thử nghiệm; không đảm bảo tải tài nguyên hay khả năng sử dụng."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "將 SiriMode 設為 2，不偽裝硬件。此功能屬實驗性質，不保證資源下載或功能可用。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "將 SiriMode 設為 2，不偽裝硬體。此功能為實驗性質，不保證資源下載或功能可用。"
          }
        }
      }
    },
    "Restore Hardware Identity": {
      "localizations": {
        "en": {
          "stringUnit": {
