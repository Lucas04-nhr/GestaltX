    "iOS could not start the background pairing task. Keep GestaltX open, or try again in a moment.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS could not start the background pairing task. Keep GestaltX open, or try again in a moment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 没能启动后台配对任务。请保持 GestaltX 在前台，或稍后重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS no pudo iniciar la tarea de emparejamiento en segundo plano. Mantén GestaltX abierto o inténtalo de nuevo en un momento."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS نتوانست وظیفه جفت‌سازی پس‌زمینه را شروع کند. GestaltX را باز نگه دارید یا کمی بعد دوباره تلاش کنید."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS がバックグラウンドのペアリングタスクを開始できませんでした。GestaltX を開いたままにするか、しばらくしてから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 백그라운드 페어링 작업을 시작하지 못했습니다. GestaltX를 열어 두거나 잠시 후 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS не удалось запустить фоновую задачу сопряжения. Оставьте GestaltX открытым или повторите попытку позже."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS, arka plan eşleştirme görevini başlatamadı. GestaltX'i açık tutun veya kısa süre sonra tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS không thể khởi động tác vụ ghép nối nền. Hãy giữ GestaltX mở hoặc thử lại sau."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 無法啟動背景配對任務。請讓 GestaltX 保持在前景，或稍後再試。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 無法啟動背景配對任務。請讓 GestaltX 保持在前景，或稍後再試。"
          }
        }
      }
    },
